{
  "name": "candy-term",
  "private": true,
  "version": "0.1.4",
  "description": "candy-term / 糖果终端 — High-performance SSH & SFTP desktop client built with Rust, Tauri, Vue 3, TypeScript, Pinia, Tailwind CSS, and shadcn-vue.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "postinstall": "simple-git-hooks",
    "release": "release-it"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.0.2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.23"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "release-it": "^21.1.3",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^2.2.8"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no-install commitlint -e"
  }
}
